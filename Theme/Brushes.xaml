<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Theme/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="WindowBackgroundBrush" popt:Freeze="True" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" popt:Freeze="True" Color="{StaticResource ControlBackgroundColor}" />

    <SolidColorBrush x:Key="CharcoalGrayBrush" popt:Freeze="True" Color="{StaticResource CharcoalGrayColor}" />
    <SolidColorBrush x:Key="CharcoalAshBrush" popt:Freeze="True" Color="{StaticResource CharcoalAshColor}" />
    <SolidColorBrush x:Key="CharcoalAshBrushOpacity50" popt:Freeze="True" Color="{StaticResource CharcoalAshColorOpacity50}" />
    <SolidColorBrush x:Key="DimGrayBrush" popt:Freeze="True" Color="{StaticResource DimGrayColor}" />
    <SolidColorBrush x:Key="DimGrayBrushOpacity30" popt:Freeze="True" Color="{StaticResource DimGrayColorOpacity30}" />
    <SolidColorBrush x:Key="DimGrayBrushOpacity50" popt:Freeze="True" Color="{StaticResource DimGrayColorOpacity50}" />

    <SolidColorBrush x:Key="AzureBrush" popt:Freeze="True" Color="{StaticResource AzureColor}" />
    <SolidColorBrush x:Key="AzureBrushOpacity20" popt:Freeze="True" Color="{StaticResource AzureColorOpacity20}" />
    <SolidColorBrush x:Key="AzureBrushOpacity30" popt:Freeze="True" Color="{StaticResource AzureColorOpacity30}" />
    <SolidColorBrush x:Key="AzureBrushOpacity50" popt:Freeze="True" Color="{StaticResource AzureColorOpacity50}" />
    <SolidColorBrush x:Key="DeepAzureBrush" popt:Freeze="True" Color="{StaticResource DeepAzureColor}" />
    <SolidColorBrush x:Key="DeepAzureBrushOpacity50" popt:Freeze="True" Color="{StaticResource DeepAzureColorOpacity50}" />
    <SolidColorBrush x:Key="AzureMistBrush" popt:Freeze="True" Color="{StaticResource AzureMistColor}" />

    <SolidColorBrush x:Key="SageMistBrush" popt:Freeze="True" Color="{StaticResource SageMistColor}" />
    <SolidColorBrush x:Key="SoftAshBrush" popt:Freeze="True" Color="{StaticResource SoftAshColor}" />
    <SolidColorBrush x:Key="WhiteBrush" popt:Freeze="True" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="WhiteBrushOpacity10" popt:Freeze="True" Color="{StaticResource WhiteColorOpacity10}" />
    <SolidColorBrush x:Key="BlackBrush" popt:Freeze="True" Color="{StaticResource BlackColor}" />

    <SolidColorBrush x:Key="VermilionBrush" popt:Freeze="True" Color="{StaticResource VermilionColor}" />
    <SolidColorBrush x:Key="VermilionBrushOpacity20" popt:Freeze="True" Color="{StaticResource VermilionColorOpacity20}" />
    <SolidColorBrush x:Key="CrimsonBrush" popt:Freeze="True" Color="{StaticResource CrimsonColor}" />
    <SolidColorBrush x:Key="AmberBrush" popt:Freeze="True" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberBrushOpacity20" popt:Freeze="True" Color="{StaticResource AmberColorOpacity20}" />
    <SolidColorBrush x:Key="EmeraldBrush" popt:Freeze="True" Color="{StaticResource EmeraldColor}" />
    <SolidColorBrush x:Key="EmeraldBrushOpacity20" popt:Freeze="True" Color="{StaticResource EmeraldColorOpacity20}" />
    <SolidColorBrush x:Key="VioletBrush" popt:Freeze="True" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="VioletBrushOpacity20" popt:Freeze="True" Color="{StaticResource VioletColorOpacity20}" />
    <SolidColorBrush x:Key="GoldBrush" popt:Freeze="True" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldBrushOpacity20" popt:Freeze="True" Color="{StaticResource GoldColorOpacity20}" />
</ResourceDictionary>

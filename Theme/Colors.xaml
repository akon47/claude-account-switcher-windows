<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (VS-style). 실제로 쓰는 토큰만 둔다 — 필요한 투명도 단계는 여기 추가. -->
    <Color x:Key="WindowBackgroundColor">#1E1E1F</Color>
    <Color x:Key="ControlBackgroundColor">#212121</Color>

    <Color x:Key="CharcoalGrayColor">#272727</Color>
    <Color x:Key="CharcoalAshColor">#444444</Color>
    <Color x:Key="CharcoalAshColorOpacity50">#80444444</Color>
    <Color x:Key="DimGrayColor">#696969</Color>
    <Color x:Key="DimGrayColorOpacity30">#4D696969</Color>
    <Color x:Key="DimGrayColorOpacity50">#80696969</Color>

    <!-- Accent -->
    <Color x:Key="AzureColor">#0078D4</Color>
    <Color x:Key="AzureColorOpacity20">#330078D4</Color>
    <Color x:Key="AzureColorOpacity30">#4D0078D4</Color>
    <Color x:Key="AzureColorOpacity50">#800078D4</Color>
    <Color x:Key="DeepAzureColor">#2A72B5</Color>
    <Color x:Key="DeepAzureColorOpacity50">#802A72B5</Color>
    <Color x:Key="AzureMistColor">#60CDFF</Color>

    <!-- Text -->
    <Color x:Key="SageMistColor">#9EA2AE</Color>
    <Color x:Key="SoftAshColor">#E8EAED</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="WhiteColorOpacity10">#1AFFFFFF</Color>
    <Color x:Key="BlackColor">#000000</Color>

    <!-- Semantic: 상태/뱃지 -->
    <Color x:Key="VermilionColor">#E34234</Color>
    <Color x:Key="VermilionColorOpacity20">#33E34234</Color>
    <Color x:Key="CrimsonColor">#DC143C</Color>
    <Color x:Key="AmberColor">#FF9800</Color>
    <Color x:Key="AmberColorOpacity20">#33FF9800</Color>
    <Color x:Key="EmeraldColor">#4CAF50</Color>
    <Color x:Key="EmeraldColorOpacity20">#334CAF50</Color>
    <Color x:Key="VioletColor">#A06CFF</Color>
    <Color x:Key="VioletColorOpacity20">#33A06CFF</Color>
    <Color x:Key="GoldColor">#F5C542</Color>
    <Color x:Key="GoldColorOpacity20">#33F5C542</Color>
</ResourceDictionary>

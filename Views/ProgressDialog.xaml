<ctrl:ThemedWindow
    x:Class="ClaudeAccountSwitcher.Views.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:ClaudeAccountSwitcher.Controls"
    xmlns:loc="clr-namespace:ClaudeAccountSwitcher.Localization"
    xmlns:b="clr-namespace:ClaudeAccountSwitcher.Behaviors"
    Title="{loc:Loc UpdTitle}"
    Width="400"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{DynamicResource ThemedWindowStyle}"
    b:WindowClosingCommandBehavior.Command="{Binding CancelCommand}"
    >
    <ctrl:ThemedWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </ctrl:ThemedWindow.InputBindings>
    <StackPanel Margin="22 20">
        <TextBlock
            Text="{Binding Status}"
            TextWrapping="Wrap"
            Foreground="{DynamicResource WhiteBrush}"
            />
        <ProgressBar
            Height="8"
            Margin="0 14 0 8"
            Minimum="0"
            Maximum="100"
            Value="{Binding Progress}"
            />
        <Grid>
            <TextBlock
                Text="{Binding ProgressText}"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SageMistBrush}"
                />
            <Button
                Content="{loc:Loc DlgCancel}"
                HorizontalAlignment="Right"
                MinWidth="84"
                Height="30"
                Command="{Binding CancelCommand}"
                />
        </Grid>
    </StackPanel>
</ctrl:ThemedWindow>

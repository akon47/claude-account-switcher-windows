<ctrl:ThemedWindow
    x:Class="ClaudeAccountSwitcher.Views.SessionBrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:ClaudeAccountSwitcher.Behaviors"
    xmlns:conv="clr-namespace:ClaudeAccountSwitcher.Converters"
    xmlns:ctrl="clr-namespace:ClaudeAccountSwitcher.Controls"
    xmlns:loc="clr-namespace:ClaudeAccountSwitcher.Localization"
    Title="{loc:Loc SessWinTitle}"
    Width="880"
    Height="560"
    MinWidth="620"
    MinHeight="400"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    Style="{DynamicResource ThemedWindowStyle}"
    >
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source: account selector (or loaded bundle file) + import button -->
        <Grid
            Grid.Row="0"
            Margin="0 0 0 12"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{loc:Loc SessSourceLabel}"
                VerticalAlignment="Center"
                Margin="0 0 8 0"
                Foreground="{DynamicResource WhiteBrush}"
                />
            <ComboBox
                Grid.Column="1"
                Width="340"
                ItemsSource="{Binding SourceAccounts}"
                SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                DisplayMemberPath="Display"
                />

            <!-- Loaded-from-file indicator (import mode) -->
            <TextBlock
                Grid.Column="2"
                Margin="12 0 8 0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource SageMistBrush}"
                Text="{Binding FileSourceName, StringFormat=📄 {0}}"
                ToolTip="{Binding FileSourceName}"
                >
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFileSource}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button
                Grid.Column="3"
                Content="{loc:Loc SessImportBtn}"
                Padding="12 6"
                Command="{Binding ImportFromFileCommand}"
                ToolTip="{loc:Loc SessImportTip}"
                />
        </Grid>

        <!-- Session list + busy/empty overlay -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource CharcoalAshBrush}"
            BorderThickness="1"
            >
            <Grid>
                <ListView
                    BorderThickness="0"
                    Background="Transparent"
                    SelectionMode="Extended"
                    ItemsSource="{Binding Sessions}"
                    SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                    b:ListViewSelectedItemsBehavior.BoundSelection="{Binding SelectedSessions}"
                    >
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Header="{loc:Loc SessColProject}"
                                Width="150"
                                >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Text="📁"
                                                Margin="0 0 4 0"
                                                ToolTip="{loc:Loc SessHasFolderTip}"
                                                Visibility="{Binding HasWorkdir, Converter={conv:TruthyToVisibleConverter}}"
                                                />
                                            <TextBlock
                                                Text="{Binding Project}"
                                                ToolTip="{Binding Cwd}"
                                                TextTrimming="CharacterEllipsis"
                                                />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Header="{loc:Loc SessColName}"
                                Width="210"
                                >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            ToolTip="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource WhiteBrush}"
                                            />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn
                                Header="{loc:Loc SessColWhen}"
                                Width="88"
                                DisplayMemberBinding="{Binding When}"
                                />
                            <GridViewColumn
                                Header="{loc:Loc SessColPreview}"
                                Width="290"
                                >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding Preview}"
                                            ToolTip="{Binding Preview}"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource SageMistBrush}"
                                            />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock
                    Text="{loc:Loc SessLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SageMistBrush}"
                    >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock
                    Text="{loc:Loc SessEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="360"
                    TextAlignment="Center"
                    Foreground="{DynamicResource SageMistBrush}"
                    >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Actions: export + destination account + resume/close -->
        <Grid
            Grid.Row="2"
            Margin="0 12 0 0"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Content="{loc:Loc SessExportBtn}"
                Padding="12 6"
                Command="{Binding ExportCommand}"
                ToolTip="{loc:Loc SessExportTip}"
                />

            <TextBlock
                Grid.Column="2"
                Text="{loc:Loc SessDestLabel}"
                VerticalAlignment="Center"
                Margin="0 0 8 0"
                Foreground="{DynamicResource WhiteBrush}"
                />
            <ComboBox
                Grid.Column="3"
                HorizontalAlignment="Left"
                Width="280"
                ItemsSource="{Binding DestAccounts}"
                SelectedItem="{Binding SelectedDest, Mode=TwoWay}"
                DisplayMemberPath="Display"
                />
            <Button
                Grid.Column="4"
                Content="{loc:Loc SessResume}"
                Margin="6 0"
                Padding="12 6"
                Command="{Binding ResumeCommand}"
                Style="{DynamicResource AccentButtonStyle}"
                />
            <Button
                Grid.Column="5"
                Content="{loc:Loc SessClose}"
                Margin="6 0 0 0"
                Padding="12 6"
                IsCancel="True"
                />
        </Grid>
    </Grid>
</ctrl:ThemedWindow>

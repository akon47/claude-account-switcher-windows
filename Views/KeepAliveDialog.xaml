<ctrl:ThemedWindow
    x:Class="ClaudeAccountSwitcher.Views.KeepAliveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:ClaudeAccountSwitcher.Behaviors"
    xmlns:ctrl="clr-namespace:ClaudeAccountSwitcher.Controls"
    xmlns:loc="clr-namespace:ClaudeAccountSwitcher.Localization"
    Title="{Binding Title}"
    Width="540"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{DynamicResource ThemedWindowStyle}"
    b:DialogResultBehavior.Result="{Binding DialogResult}"
    >
    <StackPanel Margin="24 20">
        <!-- Mode: always (restart the moment the window resets) -->
        <RadioButton
            GroupName="KeepAliveMode"
            Content="{loc:Loc KaModeAlways}"
            FontWeight="SemiBold"
            IsChecked="{Binding IsAlways, Mode=TwoWay}"
            />
        <TextBlock
            Text="{loc:Loc KaModeAlwaysDesc}"
            Margin="22 4 0 0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SageMistBrush}"
            />

        <!-- Mode: schedule (align windows to the reset time you want) -->
        <RadioButton
            GroupName="KeepAliveMode"
            Content="{loc:Loc KaModeSchedule}"
            FontWeight="SemiBold"
            Margin="0 16 0 0"
            IsChecked="{Binding IsSchedule, Mode=TwoWay}"
            />
        <TextBlock
            Text="{loc:Loc KaModeScheduleDesc}"
            Margin="22 4 0 0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SageMistBrush}"
            />

        <Grid
            Margin="22 12 0 0"
            IsEnabled="{Binding IsSchedule}"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="{loc:Loc KaFirstReset}"
                VerticalAlignment="Center"
                Margin="0 0 10 0"
                Foreground="{DynamicResource WhiteBrush}"
                />
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                >
                <ComboBox
                    Width="66"
                    ItemsSource="{Binding Hours}"
                    DisplayMemberPath="Label"
                    SelectedItem="{Binding SelectedHour, Mode=TwoWay}"
                    />
                <TextBlock
                    Text=":"
                    Margin="4 0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource WhiteBrush}"
                    />
                <ComboBox
                    Width="66"
                    ItemsSource="{Binding Minutes}"
                    DisplayMemberPath="Label"
                    SelectedItem="{Binding SelectedMinute, Mode=TwoWay}"
                    />
            </StackPanel>

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Text="{loc:Loc KaWindowsPerDay}"
                VerticalAlignment="Center"
                Margin="24 0 10 0"
                Foreground="{DynamicResource WhiteBrush}"
                />
            <ComboBox
                Grid.Row="0"
                Grid.Column="3"
                Width="66"
                ItemsSource="{Binding Counts}"
                DisplayMemberPath="Label"
                SelectedItem="{Binding SelectedCount, Mode=TwoWay}"
                />

            <!-- Live preview of the day's schedule -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Text="{Binding Preview}"
                Margin="0 10 0 0"
                TextWrapping="Wrap"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AzureMistBrush}"
                />
        </Grid>

        <TextBlock
            Text="{loc:Loc KaNote}"
            Margin="0 18 0 0"
            TextWrapping="Wrap"
            FontSize="11"
            Foreground="{DynamicResource SageMistBrush}"
            />

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0 20 0 0"
            >
            <Button
                Content="{loc:Loc DlgOk}"
                Width="84"
                Height="30"
                IsDefault="True"
                Margin="0 0 8 0"
                Command="{Binding AcceptCommand}"
                Style="{DynamicResource AccentButtonStyle}"
                />
            <Button
                Content="{loc:Loc DlgCancel}"
                Width="84"
                Height="30"
                IsCancel="True"
                />
        </StackPanel>
    </StackPanel>
</ctrl:ThemedWindow>
